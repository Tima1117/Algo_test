---
import Base from '../../layouts/Base.astro';
import Charts from '../../components/Charts.astro';
import { COMPARE_UK_URL, funds, meta, uks, type Uk } from '../../lib/data';
import { date, host, money, month, pct, sign } from '../../lib/format';
import Hint from '../../components/Hint.astro';
import { H } from '../../lib/hints';

export function getStaticPaths() {
  return uks.map((u) => ({ params: { inn: u.inn }, props: { u } }));
}
const { u } = Astro.props as { u: Uk };
const base = import.meta.env.BASE_URL;
const list = funds.filter((f) => f.uk_inn === u.inn).sort((a, b) => (b.nav_rub ?? -1) - (a.nav_rub ?? -1));
const ts = (m: string) => Date.UTC(+m.slice(0, 4), +m.slice(5, 7) - 1, 15) / 1000;
const chart = {
  kind: 'bars', unit: '₽', x: u.monthly.map((r) => ts(r.month)),
  series: [{ label: 'Чистый приток, ₽', values: u.monthly.map((r) => (r.funds_flow ? r.flow_rub ?? null : null)), color: '#22d3ee' }],
};
const navChart = {
  kind: 'line', monthly: true, unit: '₽', x: u.monthly.map((r) => ts(r.month)),
  series: [{ label: 'СЧА фондов с рядом, ₽', values: u.monthly.map((r) => (r.funds_nav ? r.nav_rub ?? null : null)), color: '#38bdf8' }],
};
const statusClass = (s: string) => (s === 'ok' ? 'ok' : ['partial', 'stale', 'not_formed'].includes(s) ? 'warn' : 'bad');
---
<Base title={u.short} active="rating">
  <p class="muted"><a href={base}>Рейтинг</a> / управляющая компания</p>
  <h1>{u.short}</h1>
  <p class="muted">{u.name} · ИНН <span class="mono">{u.inn}</span> · ОГРН <span class="mono">{u.ogrn}</span>
    {u.site && <> · <a href={u.site} rel="nofollow noopener" target="_blank">{host(u.site)}</a></>}</p>
  <p><a class="btn" href={`${COMPARE_UK_URL}?inn=${u.inn}`} data-tip={H.compareUk}>Открыть в разделе «Сравнить УК»</a>
    <a class="btn" href={`${base}?uk=${u.inn}`} data-tip="Открыть общий рейтинг с фильтром по этой УК">Фонды УК в рейтинге</a></p>

  <div class="grid kpis">
    <div class="panel kpi"><div class="label">Розничных фондов<Hint text={H.ukFunds} /></div><div class="value">{u.funds}</div><div class="hint">с рядом: {u.funds_with_data}</div></div>
    <div class="panel kpi"><div class="label">Суммарная СЧА<Hint text={H.ukNav} /></div><div class="value">{money(u.nav_rub)}</div><div class="hint">по фондам с рядом, {date(meta.as_of)}</div></div>
    <div class="panel kpi"><div class="label">Приток, {month(meta.last_month)}<Hint text={`${H.flowM} ${H.flow}`} /></div><div class={`value ${sign(u.flow_m)}`}>{money(u.flow_m)}</div><div class="hint">квартал: {money(u.flow_q)}</div></div>
    <div class="panel kpi"><div class="label">Приток за 12 месяцев<Hint text={H.flowY} /></div><div class={`value ${sign(u.flow_y)}`}>{money(u.flow_y)}</div><div class="hint">сумма по фондам с полным годом</div></div>
  </div>

  {u.funds_with_data > 0 && (
    <div class="grid two">
      <div class="panel"><h3>СЧА по месяцам<Hint text="Сумма СЧА фондов УК с собранной историей на конец каждого месяца. Если у фонда история начинается позже, он входит в сумму с этого месяца." /></h3><div class="chart" data-chart={JSON.stringify(navChart)}></div></div>
      <div class="panel"><h3>Чистые притоки по месяцам<Hint text={`Сумма чистых притоков фондов УК по месяцам. ${H.flow}`} /></h3><div class="chart" data-chart={JSON.stringify(chart)}></div></div>
    </div>
  )}

  <h2>Фонды</h2>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Фонд</th><th class="num">СЧА<Hint text={H.nav} /></th><th class="num">Приток, мес<Hint text={H.flowM} /></th><th class="num">Приток, год<Hint text={H.flowY} /></th><th class="num">1 год<Hint text={H.ret} /></th><th>Данные<Hint text={H.dataStatus} /></th></tr></thead>
      <tbody>
        {list.map((f) => (
          <tr>
            <td class="fund"><a href={`${base}fund/${f.rules}/`}>{f.name}</a><div class="sub">{f.type_label} · {f.category}</div></td>
            <td class="num">{money(f.nav_rub)}</td>
            <td class={`num ${sign(f.flow_m)}`}>{money(f.flow_m)}</td>
            <td class={`num ${sign(f.flow_y)}`}>{money(f.flow_y)}</td>
            <td class={`num ${sign(f.ret_1y)}`}>{pct(f.ret_1y)}</td>
            <td><span class={`badge ${statusClass(f.data_status)}`} data-tip={f.data_reason || f.data_status_label}>{f.data_status_label}</span></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="disclaimer">Суммы — только по фондам с собранным рядом; месяц без данных по фонду в сумму не входит.
    Не является инвестиционной рекомендацией.</p>
  <Charts />
</Base>
